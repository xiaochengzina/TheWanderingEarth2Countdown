; ============================================================================
; Variables.inc  用户设置（由控制面板自动写入）
;
; 你可以直接用记事本改这里，但更推荐：
;   右键皮肤 → 打开控制面板
;
; 恢复默认：控制面板 → 高级 → 恢复默认设置
;
; 注意：
;   1. 请勿删掉任何键名或删除本文件，否则皮肤会读不到设置；
;   2. 本文件必须保存为「UTF-8 带 BOM」编码（Rainmeter 靠 BOM 识别中文），
;      并且第一行不能是 [Variables] —— 文件开头的 BOM 会被当成普通字符，
;      导致紧跟其后的段名失效。所以这里保留了本注释块，请勿删除。
;   3. 内部布局常量在同目录的 Layout.inc，本文件只放「用户可以调」的东西。
; ============================================================================

[Variables]
; ------------------------------------------------------------ 文本内容 ------
; 中文主标题
CnText=距太阳氦闪
; 英文主标题
EnText=THE SOLAR HELIUM FLASH

; ------------------------------------------------------------ 目标时间 ------
; 年 / 月 / 日 / 时 / 分 / 秒。
;
; 留空 = 该项「任意」，于是目标变成一串重复时刻，倒计时到点后自动开始下一轮：
;   只留空年   → 每年 10-29 16:30:00 循环
;   年、月留空 → 每月 29 日 16:30:00 循环
;   日 / 时 / 分 以此类推
;   六项全填   → 只触发一次，到点后停在 0 秒
;
; 怎么写「留空」：
;   年 / 月 / 日 → 删掉等号后面的值，或者写 0（0 年 0 月 0 日本来就不合法）
;   时 / 分      → 必须把值删掉；写 0 就是真的 0 点 / 0 分
;   秒           → 不支持留空，删掉按 0 处理
TargetYear=2078
TargetMonth=1
TargetDay=1
TargetHour=0
TargetMinute=0
TargetSecond=0

; ------------------------------------------------------------ 单位切换 ------
; 剩余时间低于下面的值时，数字会自动换成更小的单位（最大单位是天，没有上限）：
;   UnitSwitchDay     剩余不足这么多「小时」 → 改用「小时」
;   UnitSwitchHour    剩余不足这么多「分钟」 → 改用「分钟」
;   UnitSwitchMinute  剩余不足这么多「秒」   → 改用「秒」
; 取值一律向下取整，所以阈值边界上会看到
;   3 天 → 71 小时、2 小时 → 119 分钟、1 分钟 → 89 秒 这样的跳变，这是设计如此。
; 控制面板 →「单位」页可以直接调，不用手改这里。
UnitSwitchDay=72
UnitSwitchHour=120
UnitSwitchMinute=90

; ------------------------------------------------------------ 外观 ----------
; 整体缩放倍数（= ScalePercent / 100，由控制面板自动同步）
Scale=1.00
; 整体缩放百分比（40 - 200）
ScalePercent=100
; 强调色：红色竖条 + 大号天数
ColorAccent=128,47,45
; 正文色：中文标题 / 英文两行
ColorText=42,189,115

; ------------------------------------------------------------ 面板状态 ------
; 面板当前停留的页码（1 内容 / 2 外观 / 3 单位 / 4 高级），由面板自动维护。
; 面板**开着的期间**会停在你翻到的那一页（取色器改完颜色会刷新面板，
; 也仍然停在原页）；点右上角关闭时会被写回 1，所以下次打开还是内容页。
SettingsPage=4
