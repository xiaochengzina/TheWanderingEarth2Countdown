; ============================================================================
; Layout.inc  内部布局常量（设计基准值 · 单位：像素）
;
; 这些数字共同决定了皮肤的像素级排布，全部按 Scale = 1 时给出。
; 皮肤里所有坐标 / 字号都写成 (#常量# * #Scale#)，因此改 Scale 只会等比
; 缩放，不会破坏对齐关系。
;
; 数值来源：对着设计稿（963 × 363 的参考渲染图）逐元素量 ink 边界反推，
;           再用「渲染 → 量测 → 修正」迭代收敛。当前误差在 1–2px 以内。
;
; 【普通用户请勿修改本文件】
;   想改文字、目标日期、颜色、整体大小 → 请用控制面板
;
; 注意：本文件需保存为 UTF-16 LE（带 BOM），且第一行不能是 [Variables]
;       （原因见 Variables.inc 顶部说明）。
; ============================================================================

[Variables]
; ---------------------------------------------------------------- 字体 ------
; 字体文件放在 @Resources\Fonts 下，Rainmeter 会自动加载，无需安装到系统。
; FontEn   英文两行
; FontDays 大号天数（可以单独换一款更窄/更重的 DIN）
FontCn=字魂59号-创粗黑
FontEn=DIN 1451 LT W06 Mittelschrift
FontDays=DIN 1451 LT W06 Mittelschrift

; ------------------------------------------------------------ 画布留白 ------
; 窗口四周的空白：
;   左边  → 由 TitleX 决定（窗口原点固定在皮肤坐标 0,0）
;   右/下 → 由 CountDown.ini 里两个完全透明的「留白 meter」撑出来
; 全部设为 0 就是紧贴内容。
; 现在四周都收干净了（作者要求「窗口大小 = 可见内容大小」）：
; 左边的留白由 TitleX 决定（已改成 0），右边的由 PadRight 决定。
; 注意坐标常量已经整体平移过 —— 上边距 19px 和左边距 33.3px 都减掉了，
; 所以这里的值跟设计稿的原始数值差一个 (33.3, 19) 的偏移。
PadRight=0
PadBottom=0

; ---------------------------------------------------------------- 字号 ------
; 中文 75pt —— 设计稿里「距太阳氦闪」的 ink 宽 424px、高 79px
CnFontSize=75
; 中文字间距（负值让字形更紧凑）
CnSpacing=-4.7
; 英文 36.3pt —— 「THE SOLAR HELIUM FLASH」ink 宽 588px、高 34px
EnFontSize=36.3
EnSpacing=0.5
; 大号天数 203pt —— 数字 cap 高 195px
DaysFontSize=203
; 大号数字的字间距（负值收窄）
;
; 为什么需要它：设计稿里那款 DIN 比手上的 DIN 1451 LT 窄约 4%
; （设计稿单个数字 ink 宽 108 / 118，DIN 1451 LT 是 112 / 123；
;   换过 Alte DIN 1451、Bahnschrift 试过，都一样或更宽）。
; 原先用 -4.32 把数字块宽度压到设计稿尺寸，代价是数字之间挤得几乎相连
; （实测空隙只剩 3~10px，而数字本身高 270px）。作者反馈「字间距非常近」，
; 所以这里改回 0 —— 也就是这款字体的自然字距，不再做任何收窄。
; 代价：数字块比设计稿宽约 4%（5 位数约宽 57px），单位与窗口宽度随之增加。
; 哪天换成真正更窄的 DIN，这里保持 0 即可，无需负值。
DaysSpacing=0
; ------------------------------------------------------- 中文标题「距太阳氦闪」
; 设计稿 ink 位置：x38..461, y26..104
;
; TitleMaxW = 标题刚好占满设计稿宽度时，meter 的排版宽度（W）。
; 注意它不是 ink 宽度：ink 只有 423px，而 meter 的 W 还含左右边距，实测 438。
; 标题超过这个宽度后，右边整块（红条 / 还剩 / 数字 / 英文）会整体右移
; 「超出多少就移多少」，字号和内部对齐完全不变；窗口靠 DynamicWindowSize 自动加宽。
; 实现见 CountDown.ini 里那几处 [MeterCnText:W] 的公式。
;
; ⚠ 这个值是量出来的，和 CnFontSize / CnSpacing 绑在一起。改了 CnFontSize 之后
;   要重新标定：把标题设回 5 个字，读 [MeterCnText:W] 的值填回来。
;   读法：临时加一个可见的 String meter 显示 [MeterCnText:W]
;   （别用 Hidden=1 的 meter 去量，隐藏 meter 的 W 恒为 0）。
TitleMaxW=438

TitleX=0
TitleY=-3.7

; ------------------------------------------------------------ 中文副标题「还剩」
; 设计稿 ink 位置：x303..466, y131..204
SubX=266.2
SubY=100.5
CnSubText=还剩

; ---------------------------------------------------------------- 红色竖条 ---
; 比旧版更细更长：设计稿为 8 × 200，顶端与「还剩」字形顶端齐平
BarX=237.2
BarY=112.8
BarW=8
BarH=200

; ---------------------------------------------------------------- 大号天数 ---
; 说明：203 号字的「行框」比字形本身高出约 60px（字体自带上/下留白），
;       而字形顶端需要落在窗口内 y≈20 处，所以行框上沿必须是负值。
;       Rainmeter 会把超出窗口的部分裁掉，字形本身仍完整，不会缺笔画。
;       ⇒ 改 DaysFontSize 时必须同步改 DaysY，否则数字会被裁切。
;       换算关系：DaysY ≈ 20 − 0.296 × DaysFontSize
; 设计稿 ink 位置：数字块 x484..724, y20..214
DaysX=453.4
DaysY=-59

; ---------------------------------------------------------------- 单位「天」--
; X 采用相对定位：紧跟在天数右侧 UnitGap 像素处，因此 5 位数变 4 位数时
; 「天」会自动跟随，窗口宽度也随之收缩。
; 注意：这个间隙是相对「数字 meter 的排版宽度」算的，所以 DaysSpacing
;       一变，数字块宽度就变，单位会跟着整体右移。
;       （DaysSpacing 现在是 0，即自然字距，数字块比设计稿宽约 4%，
;         因此单位的绝对位置比设计稿略靠右 —— 这是作者要的取舍。）
UnitGap=18
UnitY=95.2

; ---------------------------------------------------------------- 英文两行 ---
; 设计稿 ink：第一行 x306..893 y236..269，第二行 x310..567 y294..327
EnX=271.9
EnTitleY=206.6
EnDaysY=264.6
EnDaysPrefix=IN

; ---------------------------------------------------------------- 单位 ------
; 剩余时间会自动在四种单位之间切换，这里是它们的显示文字。
; 中文用单字（天 / 时 / 分 / 秒）保持排版紧凑；
; 英文会自动按单复数在 En / EnPlural 之间选。
UnitDayCn=天
UnitHourCn=小时
UnitMinuteCn=分钟
UnitSecondCn=秒
UnitDayEn=DAY
UnitDayEnPlural=DAYS
UnitHourEn=HOUR
UnitHourEnPlural=HOURS
UnitMinuteEn=MINUTE
UnitMinuteEnPlural=MINUTES
UnitSecondEn=SECOND
UnitSecondEnPlural=SECONDS

; ------------------------------------------------------------ 单位切换 ------
; 三个切换阈值是「用户设置」，已移到 Variables.inc：
;   UnitSwitchDay / UnitSwitchHour / UnitSwitchMinute
; 控制面板 →「单位」页可以直接调，不用改文件。
; 这里只保留四种单位的显示文字（上面的 Unit*Cn / Unit*En）。
